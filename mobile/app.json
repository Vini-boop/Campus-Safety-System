{
  "expo": {
    "name": "Campus Safety",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/campus-icon.png",
    "scheme": "campus-safety",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAFez_RmaGv2mPlfAwWf1ovWYh-cmQMWow"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/campus-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAFez_RmaGv2mPlfAwWf1ovWYh-cmQMWow"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ],
      "package": "com.campussafety.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/campus-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C156D",
          "dark": {
            "backgroundColor": "#0C156D"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/campus-icon.png",
          "color": "#D32F2F",
          "androidNotificationChannels": [
            {
              "id": "campus_emergency",
              "name": "Emergency Alerts",
              "importance": "MAX",
              "vibrationPattern": [
                0,
                400,
                200,
                400,
                200,
                400
              ],
              "lightColor": "#FF0000",
              "sound": "default",
              "enableLights": true,
              "enableVibrate": true,
              "lockscreenVisibility": "PUBLIC",
              "bypassDnd": true
            },
            {
              "id": "campus_medical",
              "name": "Medical Alerts",
              "importance": "HIGH",
              "vibrationPattern": [
                0,
                300,
                150,
                300
              ],
              "lightColor": "#1565C0",
              "sound": "default",
              "enableLights": true,
              "enableVibrate": true
            },
            {
              "id": "campus_security",
              "name": "Security Alerts",
              "importance": "HIGH",
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#D50000",
              "sound": "default",
              "enableLights": true,
              "enableVibrate": true
            },
            {
              "id": "campus_general",
              "name": "General Notifications",
              "importance": "DEFAULT",
              "sound": "default"
            }
          ]
        }
      ],
      "expo-task-manager",
      "expo-font",
      "expo-web-browser",
      "./withAllowCleartextTraffic.js",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAFez_RmaGv2mPlfAwWf1ovWYh-cmQMWow",
          "iosGoogleMapsApiKey": "AIzaSyAFez_RmaGv2mPlfAwWf1ovWYh-cmQMWow"
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Campus Safety to access your camera for QR code scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./withGoogleMapsKey.js"
    ],
    "extra": {
      "googleMapsApiKey": "AIzaSyAFez_RmaGv2mPlfAwWf1ovWYh-cmQMWow",
      "router": {},
      "eas": {
        "projectId": "a7ab9d0c-86d3-49f9-a588-27478a28ccc3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a7ab9d0c-86d3-49f9-a588-27478a28ccc3",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.0",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "simbariu"
  }
}