# Firebase Configuration (mapsprocampus project)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mapsprocampus.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mapsprocampus
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mapsprocampus.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=500892681156
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Google OAuth Configuration
# Get this from Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=500892681156-tsl8up0eeblefoicdgvjfub5fo239klt.apps.googleusercontent.com

# Weather API Configuration (WeatherAPI.com — free tier)
# Get your API key from: https://www.weatherapi.com/signup.aspx
# Free tier: 1 million calls/month
# Used for displaying weather data and weather-based alerts in the app
EXPO_PUBLIC_WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE