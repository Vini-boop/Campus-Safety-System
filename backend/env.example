PORT=5000
NODE_ENV=development

# Frontend origins allowed to call this backend (comma-separated)
# Add your admin panel URL and Expo web URL as needed
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Firebase Admin credentials
# Option 1: path to service account file (recommended for local)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: inline JSON string of service account
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"safety-management-system-4faf0",...}

# Firebase project config (MUST MATCH your Firebase project)
FIREBASE_PROJECT_ID=mapsprocampus
# For Realtime Database, this usually ends with -default-rtdb
FIREBASE_DATABASE_URL=https://mapsprocampus-default-rtdb.firebaseio.com

# JWT Secrets for token management (CHANGE THESE IN YOUR real .env)
JWT_ACCESS_SECRET=your-super-secret-access-key-here-make-it-long-and-random
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-make-it-long-and-random
JWT_RESET_SECRET=your-super-secret-reset-key-here-make-it-long-and-random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Weather API (OpenWeatherMap)
# Get your API key from: https://openweathermap.org/api
# Used for fetching weather data and sending weather alerts
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Optional: override collection names
USERS_COLLECTION=users
ALERTS_COLLECTION=alerts
WEATHER_COLLECTION=weather_advisories
MOVEMENTS_COLLECTION=movements
NOTIFICATIONS_COLLECTION=notifications

NOTIFICATIONS_COLLECTION=notifications

