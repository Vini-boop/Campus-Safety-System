rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write their own report images
    match /reports/{reportId}/{imageFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.resource.size < 5 * 1024 * 1024 &&  // Max 5MB
        request.auth.uid == getOwnerFromReport(reportId);
    }
  }
  
  function getOwnerFromReport(reportId) {
    // Get the report document and return the owner's UID
    return get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId;
  }
}